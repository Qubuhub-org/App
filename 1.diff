diff --git a/db.xquery b/db.xquery
new file mode 100644
index 0000000..00e53d1
--- /dev/null
+++ b/db.xquery
@@ -0,0 +1,16 @@
+json-doc("db.json").users[]
+count(json-doc("db.json").users[])
+for $u in json-doc("db.json").users[]
+where $u.age > 16
+return $u
+for $u in json-doc("db.json").users[]
+return {
+  "username": $u.name,
+  "isAdult": $u.age >= 18
+}
+for $u in json-doc("db.json").users[]
+group by $age := $u.age
+return {
+  "age": $age,
+  "count": count($u)
+}
